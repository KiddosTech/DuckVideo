{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DuckVideo Studio",
  "version": "1.0.0",
  "identifier": "com.duckvideo.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DuckVideo Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg"
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Media downloader and optimizer",
    "longDescription": "DuckVideo Studio is a static-hosting-ready and Tauri-ready media download planner and local optimizer."
  }
}
